{
  "name": "SourceCrate MCP development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install uv==0.12.23 && uv sync --locked --extra dev --extra http",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Optional local REST API"}}
}
