{
  "mcpServers": {
    "paperez-mcp": {
      "command": "python3",
      "args": [
        "/mnt/d/repos/paperez-mcp/paperez_mcp/install_and_run.py"
      ],
      "env": {
        "UNPAYWALL_EMAIL": "research@example.com"
      }
    },
    "paperez-mcp-remote": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/JosiahSiegel/paperez-mcp.git",
        "paperez-mcp"
      ],
      "env": {
        "UNPAYWALL_EMAIL": "research@example.com"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    }
  }
}