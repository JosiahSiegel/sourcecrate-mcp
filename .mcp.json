{
  "mcpServers": {
    "source-crate-remote": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/JosiahSiegel/source-crate.git",
        "source-crate"
      ],
      "env": {
        "UNPAYWALL_EMAIL": "research@example.com",
        "PATH": "/home/node/.local/bin:${PATH}"
      }
    },
    "source-crate-local": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--no-cache",
        "--from",
        "/mnt/d/repos/source-crate",
        "source-crate"
      ],
      "env": {
        "PATH": "/home/node/.local/bin:${PATH}"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    }
  }
}
