{
  "mcpServers": {
    "paperez-mcp-remote": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/JosiahSiegel/paperez-mcp.git",
        "paperez-mcp"
      ],
      "env": {
        "UNPAYWALL_EMAIL": "research@example.com",
        "PATH": "/home/node/.local/bin:${PATH}"
      }
    },
    "paperez-mcp-local": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--no-cache",
        "--from",
        "/mnt/d/repos/paperez-mcp",
        "paperez-mcp"
      ],
      "env": {
        "PATH": "/home/node/.local/bin:${PATH}"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    }
  }
}
