{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Grep",
      "Glob",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "BashOutput",
      "KillBash",
      "ExitPlanMode",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs"
    ],
    "ask": [],
    "deny": [],
    "defaultMode": "plan"
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "outputStyle": "standard",
  "includeCoAuthoredBy": true,
  "enableAllProjectMcpServers": true
}
